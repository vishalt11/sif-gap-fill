make_sif_polygon <- function(lon1, lat1, lon2, lat2, lon3, lat3, lon4, lat4) {
st_polygon(list(rbind(
c(lon1, lat1),
c(lon2, lat2),
c(lon3, lat3),
c(lon4, lat4),
c(lon1, lat1)
)))
}
df_sif_polygons <- df %>%
mutate(sif_row_id = row_number(), across(all_of(c("Latitude", "Longitude", corner_cols, target_col)), as.numeric)) %>%
