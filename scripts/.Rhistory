library(tidyverse)
library(sf)
library(terra)
sif_sf <- readRDS("data/ns_sif_mgrs_crop_composition.rds")
stac_url <- "https://geoservice.dlr.de/eoc/ogc/stac/v1"
collection <- "S2_L3A_WASP"
band_asset <- "FRC_B8"
target_tiles <- sort(unique(sif_sf$mgrs_tile))
target_months <- sort(unique(format(as.Date(sif_sf$Delta_Date), "%Y-%m")))
target_tiles
target_months
# Query slightly beyond the SIF point envelope so STAC returns all relevant
# Niedersachsen tiles, then filter explicitly by MGRS tile ID below.
sif_bbox <- sf::st_bbox(sif_sf)
query_bbox <- c(
unname(sif_bbox["xmin"]) - 0.05,
unname(sif_bbox["ymin"]) - 0.05,
unname(sif_bbox["xmax"]) + 0.05,
unname(sif_bbox["ymax"]) + 0.05
)
month_window <- function(year_month) {
start <- as.Date(paste0(year_month, "-01"))
end <- seq(start, by = "1 month", length.out = 2)[2]
paste0(format(start, "%Y-%m-%d"), "T00:00:00Z/",
format(end, "%Y-%m-%d"), "T00:00:00Z")
}
stac_items_url <- function(year_month, bbox) {
query <- paste0(
"limit=100",
"&bbox=", paste(bbox, collapse = ","),
"&datetime=", month_window(year_month),
"&f=json"
)
paste0(
stac_url, "/collections/", collection, "/items?",
utils::URLencode(query, reserved = TRUE)
)
}
read_url_text <- function(url) {
paste(readLines(url, warn = FALSE), collapse = "\n")
}
extract_items_for_tile <- function(json_text, tile) {
item_pattern <- paste0(
'"id"\\s*:\\s*"(SENTINEL2[^"]*_L3A_T', tile, '_C)"'
)
href_pattern <- paste0(
'"', band_asset, '"\\s*:\\s*\\{.*?"href"\\s*:\\s*"([^"]+)"'
)
item_matches <- gregexpr(item_pattern, json_text, perl = TRUE)
item_ids <- regmatches(json_text, item_matches)[[1]]
if (length(item_ids) == 0 || identical(item_ids, character(0))) {
return(tibble(
mgrs_tile = tile,
item_id = NA_character_,
asset_href = NA_character_,
stac_has_item = FALSE,
stac_has_band = FALSE
))
}
starts <- as.integer(item_matches[[1]])
item_ids <- sub(item_pattern, "\\1", item_ids, perl = TRUE)
next_starts <- c(starts[-1], nchar(json_text) + 1)
map2_dfr(item_ids, seq_along(item_ids), function(item_id, i) {
item_text <- substr(json_text, starts[i], next_starts[i] - 1)
href_match <- regexpr(href_pattern, item_text, perl = TRUE)
href <- if (href_match[1] > 0) {
sub(href_pattern, "\\1", regmatches(item_text, href_match), perl = TRUE)
} else {
NA_character_
}
tibble(
mgrs_tile = tile,
item_id = item_id,
asset_href = href,
stac_has_item = TRUE,
stac_has_band = !is.na(href)
)
})
}
url_exists <- function(url) {
if (is.na(url)) {
return(NA)
}
response <- try(
suppressWarnings(system2(
"curl",
args = c("--head", "--location", "--fail", "--silent", "--show-error", url),
stdout = TRUE,
stderr = TRUE
)),
silent = TRUE
)
!inherits(response, "try-error") && is.null(attr(response, "status"))
}
query_month <- function(year_month) {
message("Querying ", year_month)
url <- stac_items_url(year_month, query_bbox)
json_text <- read_url_text(url)
map_dfr(target_tiles, function(tile) {
extract_items_for_tile(json_text, tile)
}) |>
mutate(
year_month = year_month,
band = band_asset,
asset_reachable = map_lgl(asset_href, url_exists),
.before = mgrs_tile
)
}
band8_availability <- map_dfr(target_months, query_month) |>
arrange(year_month, mgrs_tile, item_id)
print(band8_availability, n = Inf)
availability_summary <- band8_availability |>
group_by(year_month, mgrs_tile) |>
summarise(
stac_items = sum(stac_has_item),
band8_assets = sum(stac_has_band),
reachable_band8_assets = sum(asset_reachable, na.rm = TRUE),
.groups = "drop"
)
print(availability_summary, n = Inf)
library(tidyverse)
library(sf)
library(terra)
library(rstac)
sif_sf <- readRDS("data/ns_sif_mgrs_crop_composition.rds")
stac_url <- "https://geoservice.dlr.de/eoc/ogc/stac/v1"
collection <- "S2_L3A_WASP"
band_asset <- "FRC_B8"
target_tiles <- sort(unique(sif_sf$mgrs_tile))
target_months <- sort(unique(format(as.Date(sif_sf$Delta_Date), "%Y-%m")))
# Use the SIF footprint as the search area. STAC returns all monthly WASP
# products intersecting this bbox; we then filter exactly to the MGRS tiles.
sif_bbox <- sf::st_bbox(sif_sf)
query_bbox <- c(
unname(sif_bbox["xmin"]) - 0.05,
unname(sif_bbox["ymin"]) - 0.05,
unname(sif_bbox["xmax"]) + 0.05,
unname(sif_bbox["ymax"]) + 0.05
)
query_bbox
sif_bbox
month_window <- function(year_month) {
start <- as.Date(paste0(year_month, "-01"))
end <- seq(start, by = "1 month", length.out = 2)[2]
paste0(format(start, "%Y-%m-%d"), "/", format(end, "%Y-%m-%d"))
}
item_tile <- function(item_id) {
stringr::str_match(item_id, "_T([0-9]{2}[A-Z]{3})_")[, 2]
}
asset_href <- function(feature, asset_name) {
href <- feature$assets[[asset_name]]$href
if (is.null(href)) {
NA_character_
} else {
href
}
}
url_exists <- function(url) {
if (is.na(url)) {
return(NA)
}
response <- try(
suppressWarnings(system2(
"curl",
args = c("--head", "--location", "--fail", "--silent", "--show-error", url),
stdout = TRUE,
stderr = TRUE
)),
silent = TRUE
)
!inherits(response, "try-error") && is.null(attr(response, "status"))
}
query_month <- function(year_month) {
message("Querying ", year_month)
items <- stac(stac_url) |>
stac_search(
collections = collection,
bbox = query_bbox,
datetime = month_window(year_month),
limit = 100
) |>
post_request() |>
items_fetch(progress = FALSE)
features <- items$features
if (length(features) == 0) {
return(tibble(
year_month = year_month,
mgrs_tile = target_tiles,
item_id = NA_character_,
band = band_asset,
asset_href = NA_character_,
stac_has_item = FALSE,
stac_has_band = FALSE,
asset_reachable = NA
))
}
found <- map_dfr(features, function(feature) {
id <- feature$id
tile <- item_tile(id)
href <- asset_href(feature, band_asset)
tibble(
year_month = year_month,
mgrs_tile = tile,
item_id = id,
band = band_asset,
asset_href = href,
stac_has_item = TRUE,
stac_has_band = !is.na(href)
)
}) |>
filter(mgrs_tile %in% target_tiles)
missing_tiles <- setdiff(target_tiles, found$mgrs_tile)
missing_rows <- if (length(missing_tiles) > 0) {
tibble(
year_month = year_month,
mgrs_tile = missing_tiles,
item_id = NA_character_,
band = band_asset,
asset_href = NA_character_,
stac_has_item = FALSE,
stac_has_band = FALSE
)
} else {
tibble(
year_month = character(),
mgrs_tile = character(),
item_id = character(),
band = character(),
asset_href = character(),
stac_has_item = logical(),
stac_has_band = logical()
)
}
bind_rows(found, missing_rows) |>
mutate(asset_reachable = map_lgl(asset_href, url_exists))
}
band8_availability <- map_dfr(target_months, query_month) |>
arrange(year_month, mgrs_tile, item_id)
band8_availability <- map_dfr(target_months, query_month) |>
arrange(year_month, mgrs_tile, item_id)
