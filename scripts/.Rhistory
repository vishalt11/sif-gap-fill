max(df$aggregated_target_modis_sif)
sort(df$aggregated_target_modis_sif)
?sort
sort(df$aggregated_target_modis_sif, decreasing = FALSE)
sort(df$aggregated_target_modis_sif, decreasing = TRUE)
temp <- df %>% filter(aggregated_target_modis_sif > 1)
temp
View(temp)
temp <- df %>% filter(aggregated_target_modis_sif > 0.9)
