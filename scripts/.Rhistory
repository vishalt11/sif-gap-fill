unique(lubridate::month(sif_sf$Delta_Date))
unique(lubridate::ym(sif_sf$Delta_Date))
unique(lubridate::ymd(sif_sf$Delta_Date))
unique(lubridate::floor_date(sif_sf$Delta_Date))
unique(format(sif_sf$Delta_Date, "%Y-%m"))
